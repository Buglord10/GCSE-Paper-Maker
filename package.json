{
  "name": "gcse-paper-maker",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . GCSE paper maker --out=../dist --overwrite --platform=win32 --arch=x64 --asar --icon=C:/Users/dhill/Downloads/GCSE-Paper-Maker/GCSE_Paper_Maker.ico",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Create and customise GCSE-style exam papers.",
  "author": "GCSE Paper Maker",
  "build": {
    "appId": "uk.gcsepapermaker.app",
    "productName": "GCSE Paper Maker",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "GCSE_Paper_Maker.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
